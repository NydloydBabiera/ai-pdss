// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model instructor {
  id         Int      @id @default(autoincrement())
  firstName  String
  middleName String
  lastName   String
  email      String
  age        Int
  address    String
  birthDate  DateTime
  gender     Gender
  isActive   Boolean
  account    account?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
}

model student {
  id           Int            @id @default(autoincrement())
  firstName    String
  middleName   String
  lastName     String
  email        String
  age          Int
  address      String
  birthDate    DateTime
  gender       Gender
  idCode       String @unique
  isActive     Boolean
  studentLevel studentLevel[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now())
  attendance   attendance[]
}

model studentSequence {
  year       Int @id
  lastNumber Int @default(0)
}

model account {
  id           Int        @id @default(autoincrement())
  email        String
  password     String
  token        String
  isActive     Boolean
  isFirstLogin Boolean
  instructorId Int        @unique
  Role         Role
  instructor   instructor @relation(fields: [instructorId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now())
  sessions   AccountSession[]
}

model AccountSession {
  id        Int      @id @default(autoincrement())
  accountId Int
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  account account @relation(fields: [accountId], references: [id])
}

model academicLevel {
  id           Int            @id @default(autoincrement())
  department   String
  level        String
  class        String
  studentLevel studentLevel[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now())
}

model academicYear {
  id           Int            @id @default(autoincrement())
  start        DateTime
  end          DateTime
  isCurrent    Boolean
  studentLevel studentLevel[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now())
}

model studentLevel {
  id              Int           @id @default(autoincrement())
  studentId       Int
  student         student       @relation(fields: [studentId], references: [id])
  academicLevelId Int
  academicLevel   academicLevel @relation(fields: [academicLevelId], references: [id])
  academicYearId  Int
  academicYear    academicYear  @relation(fields: [academicYearId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now())
}

model subject {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  code        String
  isActive    Boolean
  schedule    schedule[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now())
}

model schedule {
  id         Int          @id @default(autoincrement())
  time       DateTime
  day        String
  dayCode    String
  isActive   Boolean
  attendance attendance[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now())
  subject    subject?     @relation(fields: [subjectId], references: [id])
  subjectId  Int?
}

model attendance {
  id        Int              @id @default(autoincrement())
  schedule  schedule[]
  student   student[]
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now())
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum Gender {
  MALE
  FEMALE
}

enum Role {
  ADMIN
  STAFF
  TEACHER
}
